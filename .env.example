# Supabase Configuration
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your_project_id_here.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your_publishable_anon_key_here"

# Google Analytics 4
# Found in: Google Analytics -> Admin -> Data Streams -> your stream -> Measurement ID
VITE_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Site URL (canonical base, no trailing slash)
# Used for sitemap, OG tags, and Schema.org. Override if deploying to a custom domain.
VITE_SITE_URL="https://handtext-answer.vercel.app"
